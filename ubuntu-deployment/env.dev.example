# Portainer stack env vars for the DEV env (stack name: web10-dev).
# VPN-ONLY: every DNS record below points at the box's INTERNAL LAN
# IP (VM_IP) — resolves publicly, routes nowhere off-VPN, zero
# port-forwards. TLS certs MUST use the DNS-01 challenge (HTTP-01
# can't reach a VPN-only vhost). See STAGING-RUNBOOK.md "Environments".
#
# Paste these into Portainer → Stacks → web10-dev → Environment
# variables (Portainer has no env-file upload; this file is the
# documented source of truth for what to paste).

STACK=web10-dev

# node identity + backend origins (baked into frontend builds)
PROVIDER=dev.web10.app
API_ORIGIN=https://dev.web10.app
API_HOST=dev.web10.app
AUTH_ORIGIN=https://auth.dev.web10.app
RTC_HOST=rtc.dev.web10.app
MINIO_HOST=minio.dev.web10.app
MARKETING_API_ORIGIN=https://marketing-api.dev.web10.app

# CORS: every browser origin that calls the api
CORS_SERVICE_MANAGERS=auth.dev.web10.app,social.dev.web10.app,www.dev.web10.app

# secrets — generate fresh, never reuse across envs
MINIO_PASSWORD=
