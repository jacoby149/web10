# Portainer stack env vars for the DEV env (stack name: web10-dev).
# VPN-ONLY: every DNS record below points at the box's INTERNAL LAN
# IP (VM_IP) — resolves publicly, routes nowhere off-VPN, zero
# port-forwards. TLS certs MUST use the DNS-01 challenge (HTTP-01
# can't reach a VPN-only vhost). See STAGING-RUNBOOK.md "Environments".
#
# Paste these into Portainer → Stacks → web10-dev → Environment
# variables (Portainer has no env-file upload; this file is the
# documented source of truth for what to paste).

STACK=web10-dev

# DB: dev defaults to the containerized FerretDB (self-contained stack).
# DB_URL is optional — unset means mongodb://web10-dev-ferretdb:27017/
# To connect to a COPY of the real mongo for dev testing (A7 gate):
# DB_URL=mongodb://host.docker.internal:27017/

# node identity + backend origins (baked into frontend builds)
PROVIDER=api.dev.web10.app
API_ORIGIN=https://api.dev.web10.app
API_HOST=api.dev.web10.app
AUTH_ORIGIN=https://auth.dev.web10.app
SOCIAL_ORIGIN=https://social.dev.web10.app
RTC_ORIGIN=https://rtc.dev.web10.app
# public S3 vhost: also the host baked into browser-facing presigned URLs
# (S3_PUBLIC_ENDPOINT=https://${MINIO_HOST}), so it must be a real HTTPS vhost.
MINIO_HOST=minio.dev.web10.app
MARKETING_API_ORIGIN=https://marketing-api.dev.web10.app
MARKETING_UI_ORIGIN=https://marketing.dev.web10.app

# Authenticator hosts only — sites allowed to handle consent and mint
# tokens (NOT a browser CORS list; CORS is wide open by design).
CORS_SERVICE_MANAGERS=auth.dev.web10.app

# secrets — generate fresh, never reuse across envs
MINIO_PASSWORD=
