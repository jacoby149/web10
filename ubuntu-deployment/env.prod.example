# Portainer stack env vars for the PROD env (stack name: web10-prod).
# PUBLIC: DNS records point at the box's PUBLIC IP (VM_PUBLIC_IP),
# router forwards 80/443 to NPM, real TLS. Admin panels stay LAN/VPN
# only regardless of env (E1 security model).
#
# ⚠ CUTOVER CAUTION: api.web10.app / auth.web10.app may already point
# at an older deployment — check `dig` + the operator before moving
# prod DNS. See STAGING-RUNBOOK.md "Environments".
#
# Paste into Portainer → Stacks → web10-prod → Environment variables.

STACK=web10-prod

# DB: the prod box runs MongoDB NATIVELY on the host (not in Docker).
# Override DB_URL to reach it via the host gateway. The compose file
# already has extra_hosts on the api service. If the host mongo requires
# auth, include credentials in the connection string.
# Leave unset to fall back to the containerized FerretDB (dev default).
# DB_URL=mongodb://host.docker.internal:27017/
# NOTE: the real data lives in the "deploy" database (not "web10").
# Override DB accordingly:
# DB=deploy

# node identity + backend origins (baked into frontend builds)
PROVIDER=api.web10.app
API_ORIGIN=https://api.web10.app
API_HOST=api.web10.app
AUTH_ORIGIN=https://auth.web10.app
SOCIAL_ORIGIN=https://social.web10.app
RTC_ORIGIN=https://rtc.web10.app
MINIO_HOST=minio.web10.app
MARKETING_API_ORIGIN=https://marketing-api.web10.app

# Authenticator hosts only — sites allowed to handle consent and mint
# tokens (NOT a browser CORS list; CORS is wide open by design).
CORS_SERVICE_MANAGERS=auth.web10.app

# secrets — generate fresh, never reuse across envs
MINIO_PASSWORD=
