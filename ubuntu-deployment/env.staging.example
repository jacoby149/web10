# Portainer stack env vars for the STAGING env (stack name:
# web10-staging). Public, same wiring as prod but on *.staging vhosts.
#
# The live web10-staging stack predates docker-compose.ecosystem.yml
# (it was deployed from the old docker-compose.staging.yml with only
# PROVIDER + MINIO_PASSWORD set). At the next redeploy, paste the
# ecosystem compose and set ALL of these — the stack won't deploy
# without them, by design.
#
# Paste into Portainer → Stacks → web10-staging → Environment variables.

STACK=web10-staging

# node identity + backend origins (baked into frontend builds)
PROVIDER=staging.web10.app
API_ORIGIN=https://staging.web10.app
API_HOST=staging.web10.app
AUTH_ORIGIN=https://auth.staging.web10.app
RTC_HOST=rtc.staging.web10.app
MINIO_HOST=minio.staging.web10.app
MARKETING_API_ORIGIN=https://marketing-api.staging.web10.app

# CORS: every browser origin that calls the api
CORS_SERVICE_MANAGERS=auth.staging.web10.app,social.staging.web10.app,www.staging.web10.app

# secrets — keep the value already set on the live stack
MINIO_PASSWORD=
