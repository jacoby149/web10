{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "posthog-js": ["./node_modules/posthog-js"],
      "posthog-js/*": ["./node_modules/posthog-js/*"],
      "@web10/telemetry/runtime": ["../shared/telemetry/src/runtime.ts"],
      "@web10/telemetry": ["../shared/telemetry/src/index.ts"],
      "@web10/discover/image": ["../shared/discover/src/ReliableImage.tsx"],
      // D73: the shared @web10/discover package has no node_modules of its own;
      // its bare imports resolve to this app's deps (single react instance).
      // Listed before the `*` catch-all so they win.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "lucide-react": ["./node_modules/lucide-react"],
      "react-markdown": ["./node_modules/react-markdown"],
      "rehype-sanitize": ["./node_modules/rehype-sanitize"],
      "remark-breaks": ["./node_modules/remark-breaks"],
      "remark-gfm": ["./node_modules/remark-gfm"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "*": ["./*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "dist", "node_modules"]
}
