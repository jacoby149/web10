# OS / editor
.DS_Store

# dependencies — never commit installed packages
node_modules/
package-lock.json
bun.lock

# python
__pycache__/
*.pyc
.venv/
*.egg-info/

# js build output
# (sdk/dist is the deliberate exception: it stays committed because the
#  sdk Dockerfile serves it directly as the wapi.js CDN)
ui/dist/
marketing/marketing-ui/dist/
marketing/web10-social/dist/

# expo
.expo/

# test / coverage output
coverage/
*.tsbuildinfo
marketing/marketing-ui/test-results/

# secrets / local config — env files never get committed
.env
.env.local

# org logo overrides (keep the generic defaults)
ui/public/YourOrgsLogo/*
!ui/public/YourOrgsLogo/generic*
!ui/public/YourOrgsLogo/key_*

# marketing-api runtime data (feedback store, etc.)
marketing/marketing-api/data/

# yt-export
yt-export/
