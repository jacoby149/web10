{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web10 Profile",
  "description": "Display identity \u2014 one record per user.",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "avatar_ref": {
      "type": "string",
      "description": "Reference to a media service record _id"
    },
    "bio": {
      "type": "string",
      "maxLength": 500
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "location": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
