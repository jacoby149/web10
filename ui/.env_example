REACT_APP_LOGO_LIGHT="/YourOrgsLogo/generic_school_logo_black.png"
REACT_APP_LOGO_DARK="/YourOrgsLogo/generic_school_logo_white.png"

# Backend origins this build talks to (non-local builds only — the
# window.location.protocol === "http:" dev path always uses *.localhost).
# Defaults to the web10.app production origins if unset. VITE_AUTH_ORIGIN /
# VITE_API_ORIGIN / VITE_RTC_ORIGIN are accepted as aliases too.
REACT_APP_AUTH_ORIGIN="https://auth.web10.app"
REACT_APP_API_ORIGIN="https://api.web10.app"
REACT_APP_RTC_ORIGIN="https://rtc.web10.app"