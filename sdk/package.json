{
  "name": "web10-npm",
  "version": "2.0.0",
  "description": "TypeScript SDK for the web10 protocol — typed CRUD, zero required deps",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rtc": {
      "import": "./dist/rtc/index.js",
      "types": "./dist/rtc/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm && tsc --emitDeclarationOnly --outDir dist",
    "build:rtc": "bun build src/rtc/index.ts --outdir dist/rtc --target browser --format esm && tsc --emitDeclarationOnly --outDir dist",
    "build:all": "bun run build && bun run build:rtc",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts --out docs/api --tsconfig tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacoby149/web10.git"
  },
  "author": "jacoby149",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jacoby149/web10/issues"
  },
  "homepage": "https://github.com/jacoby149/web10#readme",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "typedoc": "^0.27.0"
  },
  "peerDependencies": {
    "peerjs": "^1.4.7"
  },
  "peerDependenciesMeta": {
    "peerjs": {
      "optional": true
    }
  }
}
